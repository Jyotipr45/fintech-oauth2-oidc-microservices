  SPDX-License-Identifier: MIT

  Shared Logback fragment. Include it from a service's logback-spring.xml:

    <include resource="banking-logback-masking.xml"/>
    <root level="INFO"><appender-ref ref="BANKING_MASKED_CONSOLE"/></root>

  %maskedMsg / %maskedEx redact Bearer/Basic credentials, JWTs and secret key/value pairs
  from messages and stack traces before they are written.
-->
<included>
    <conversionRule conversionWord="maskedMsg"
                    converterClass="com.jyotiprakash.banking.security.logging.MaskingMessageConverter"/>
    <conversionRule conversionWord="maskedEx"
                    converterClass="com.jyotiprakash.banking.security.logging.MaskingThrowableConverter"/>

    <property name="BANKING_MASKED_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p [%X{correlationId:-}] [%t] %logger{40} : %maskedMsg%n%maskedEx"/>

    <appender name="BANKING_MASKED_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${BANKING_MASKED_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>
</included>
