# =============================================================================
#  Environment template for infra/docker-compose.yml
#
#  1. Copy to infra/.env           ->  cp infra/.env.example infra/.env
#     or generate random secrets   ->  ./infra/scripts/generate-env.sh
#  2. Replace EVERY value marked CHANGE_ME before starting the stack.
#
#  infra/.env is git-ignored. Never commit real values.
#  Resource servers need NO secrets to validate tokens: they only fetch
#  Keycloak's PUBLIC keys from the JWKS endpoint.
# =============================================================================

# --- Image versions (not secrets) --------------------------------------------
KEYCLOAK_VERSION=26.4
POSTGRES_VERSION=16-alpine
REDIS_VERSION=8.2-alpine

# --- PostgreSQL superuser (used only by the init script) ---------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_postgres_superuser_password

# --- Per-service databases (each service owns its own DB and DB user) --------
KEYCLOAK_DB_NAME=keycloak_db
KEYCLOAK_DB_USER=keycloak_app
KEYCLOAK_DB_PASSWORD=CHANGE_ME_keycloak_db_password

ACCOUNT_DB_NAME=account_db
ACCOUNT_DB_USER=account_app
ACCOUNT_DB_PASSWORD=CHANGE_ME_account_db_password

TRANSFER_DB_NAME=transfer_db
TRANSFER_DB_USER=transfer_app
TRANSFER_DB_PASSWORD=CHANGE_ME_transfer_db_password

# --- Redis (rate limiting + jti revocation denylist) -------------------------
REDIS_PASSWORD=CHANGE_ME_redis_password

# --- Keycloak ----------------------------------------------------------------
# Bootstrap admin for the master realm (admin console only; not used by services).
KEYCLOAK_ADMIN_USER=kc-bootstrap-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin_password

# Public issuer. Must be identical for browsers/curl and for the containers,
# otherwise the "iss" check fails. Add "127.0.0.1 keycloak" to your hosts file.
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/banking-realm

# Confidential client used by transfer-service for the client_credentials grant.
# Imported into the realm at startup via ${TRANSFER_SERVICE_CLIENT_SECRET} substitution.
TRANSFER_SERVICE_CLIENT_SECRET=CHANGE_ME_at_least_32_random_characters

# Password for the demo users (alice.customer, bob.customer, carol.admin, dave.auditor).
# Realm policy: >= 12 chars, upper, lower, digit, special character.
KEYCLOAK_TEST_USER_PASSWORD=CHANGE_ME_Demo#2026pass

# --- Edge ----------------------------------------------------------------------
GATEWAY_HOST_PORT=8000
KEYCLOAK_HOST_PORT=8080
# Comma-separated explicit origins allowed by gateway CORS (no wildcards).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Gateway rate limiting (token bucket per authenticated subject)
RATE_LIMIT_REPLENISH_RATE=10
RATE_LIMIT_BURST_CAPACITY=20
